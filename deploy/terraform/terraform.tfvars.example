# The AWS provider uses the active AWS CLI profile. The
# Temporal Cloud provider uses TEMPORAL_CLOUD_API_KEY as its bootstrap
# credential; the stack creates a separate, Namespace-scoped runtime key.

project_name        = "temporal-word-game"
temporal_account_id = "a2dd6"
aws_region          = "ca-central-1"
temporal_region     = "aws-ca-central-1"

# Set either value to 0 when scale-to-zero cost matters more than first-use latency.
api_memory_size                 = 1024
api_provisioned_concurrency     = 1
worker_provisioned_concurrency  = 1
